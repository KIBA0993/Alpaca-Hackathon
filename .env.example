# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpaca PAPER account (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true

# Only needed when decision_mode = llm
ANTHROPIC_API_KEY=your_anthropic_key
